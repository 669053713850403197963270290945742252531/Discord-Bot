# Secrets
DISCORD_TOKEN=
GITHUB_TOKEN=
EZ_HOST_API_KEY=

TINYURL_API_KEY=
CATBOX_USERHASH=
PASTEE_DEV_API_KEY=

PASTEBIN_API_DEV_KEY=
PASTEBIN_API_USER_KEY=

# Server-only Supabase project credentials for the private game-scripts bucket
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_GAME_SCRIPTS_BUCKET=

# Discord IDs
GUILD_ID=
REQUIRED_ROLE_ID=
REGISTRATION_CHANNEL_ID=
REACTION_ROLE_CHANNEL_ID=
PANEL_CHANNEL_ID=
BUYER_ROLE_ID=
REDEEM_ALERTS_CHANNEL_ID=
MODERATION_ALERTS_CHANNEL_ID=

# GitHub repo the whitelist database (Users.json) lives in
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_BRANCH=

# GitHub repo permittedKeys.txt / storedscript.lua live in
GITHUB_STORAGE_REPO=
GITHUB_STORAGE_BRANCH=

# Secret for keep_alive.py's /github-webhook route -- must match the
# "Secret" field on the Users.json repo's push webhook (Settings > Webhooks)
GITHUB_WEBHOOK_SECRET=

# Secret for keep_alive.py's /whitelist/check route
LICENSE_HMAC_SECRET=

# Set to false to skip registering /whitelist/check entirely (and never
# import api/license_server.py) -- e.g. for local testing unrelated to
# whitelisting. Defaults to true
LICENSE_SERVER_ENABLED=